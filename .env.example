# Roovert Environment Variables
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local or any file with actual secrets

# Optional: your deployed site URL, used for OpenRouter's HTTP-Referer header
# and page metadata. Falls back to https://roovert.com if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production: Groq API key for the default (Ooverta) chat model
GROQ_API_KEY=your_groq_api_key_here

# Optional: enables the OpenRouter multi-provider model picker
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: enables the Hugging Face model picker entries (Qwen, DeepSeek,
# Phi-4, Kimi, GPT-OSS, plus image generation)
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Optional: generic OpenAI-compatible provider route (app/api/provider,
# registry in app/lib/providers.ts). Each key below independently enables
# that built-in provider's models - set any subset of them, or none.
# Cerebras: free tier as of writing is 1M tokens/day. https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here
# Google Gemini: generous free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Mistral: free tier as of writing is ~1B tokens/month. https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here
# DeepSeek: pay-as-you-go, no free tier, but low per-token cost. https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Together AI: hosts open-weight models (Llama, DeepSeek, ...) with pay-as-you-go
# pricing and some free-tier model endpoints. https://api.together.ai
TOGETHER_API_KEY=your_together_api_key_here

# Optional: add any other OpenAI-compatible endpoint (including your own
# self-hosted Ollama/vLLM/LM Studio instance) without touching source code.
# A JSON array of {id, name, baseURL, apiKeyEnvVar, models: [{id, name,
# apiId, category, description}]} objects - see app/lib/providers.ts for
# the full shape and validation rules. baseURL must be the full
# /chat/completions endpoint URL. apiKeyEnvVar names another env var (set
# it too) holding that provider's key - never put a key directly in this
# JSON. Example:
# CUSTOM_PROVIDERS=[{"id":"ollama","name":"My Ollama","baseURL":"http://localhost:11434/v1/chat/completions","apiKeyEnvVar":"OLLAMA_API_KEY","models":[{"id":"llama3","name":"Llama 3 (local)","apiId":"llama3","category":"Self-hosted","description":"Local Ollama model."}]}]
#
# Example: xAI's Grok (OpenAI-compatible API, not a built-in provider above).
# GROK_API_KEY=your_grok_api_key_here
# CUSTOM_PROVIDERS=[{"id":"grok","name":"Grok","baseURL":"https://api.x.ai/v1/chat/completions","apiKeyEnvVar":"GROK_API_KEY","models":[{"id":"grok-4","name":"Grok 4","apiId":"grok-4","category":"xAI","description":"xAI's Grok model."}]}]
CUSTOM_PROVIDERS=

# Optional: Admin API key (for testing /api/admin/visitors endpoint locally)
# If not set, admin endpoint will return 503 in local development.
# AI_GATEWAY_API_KEY is accepted as a fallback name for backward compatibility.
ADMIN_API_KEY=your_admin_key_here

# Visitor tracking storage (production). Falls back to local SQLite if unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Rate limiting storage (production, shared across serverless instances).
# Falls back to a per-instance in-memory store if unset (fine for local dev,
# NOT safe for a multi-instance production deployment).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Segment.io Analytics (for anonymous user analytics)
# Get your write key from https://app.segment.com/
NEXT_PUBLIC_SEGMENT_WRITE_KEY=your_segment_write_key_here
